{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumo Trade",
  "version": "1.1.6",
  "identifier": "com.kronos.app",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lumo Trade",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "tray-popup",
        "url": "tray.html",
        "width": 360,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focusable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: http://127.0.0.1:* http://localhost:*; img-src 'self' data: blob: http: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://127.0.0.1:* http://localhost:* https://cdn.staticfile.net https://cdn.plot.ly; style-src 'self' 'unsafe-inline'; connect-src 'self' http: https: ws: wss:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../assets/kronos_ai_stock.png",
      "../assets/kronos_ai_stock.icns",
      "../assets/kronos_ai_stock.ico"
    ],
    "resources": {
      "../packaging/backend/kronos_webui_backend": "packaging/backend/kronos_webui_backend",
      "../webui/templates": "webui/templates",
      "../webui/static": "webui/static",
      "../assets": "assets",
      "../figures": "figures",
      "../config/*.json": "config/"
    }
  }
}
