{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kronos Ultra",
  "version": "1.1.6",
  "identifier": "com.kronos.app",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kronos Ultra",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../assets/kronos_ai_stock.png",
      "../assets/kronos_ai_stock.icns",
      "../assets/kronos_ai_stock.ico"
    ],
    "resources": [
      "../analysis",
      "../assets",
      "../config",
      "../examples",
      "../figures",
      "../finetune",
      "../model",
      "../resources",
      "../scripts",
      "../tools",
      "../utils",
      "../webui",
      "../quick_start.bat",
      "../quick_start.ps1",
      "../quick_start.sh",
      "../requirements.txt"
    ]
  }
}
